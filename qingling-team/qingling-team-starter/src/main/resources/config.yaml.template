# 复制为项目根目录 config.yaml 后按需调整；所有密钥继续通过环境变量提供。
qingling:
  workspace:
    id: qingling-team
    name: Qingling Team
    root: ./workspace
  data-dir: ./data

  feishu:
    enabled: false
    allowed-chats: []

  agent:
    model: qwen3.6-max-preview
    sub-agent-model: qwen3.6-max-preview
    max-iterations: 30
    max-input-tokens: 30000
    sub-agent-max-iterations: 20
    timeout: 300s

  sandbox:
    enabled: true
    url: http://localhost:8029/mcp
    workspace-dir: /workspace
    timeout: 120s
    initialization-timeout: 30s
    max-retries: 2
    enabled-tools: []
    headers: {}

  memory:
    context-dir: ./data/ctx
    db-dsn: ""

  team:
    roles: [manager, pm, rd, qa]

  debug:
    test-api-enabled: false
    reply-timeout: 300s

  metrics:
    enabled: true

  cleanup:
    enabled: true
    run-on-startup: true
    session-retention-days: 365
    rules:
      workspace/sessions/*/tmp: 1
      workspace/sessions/*/uploads: 7
      workspace/sessions/*/outputs: 30
      traces: 30

  cron:
    tick-interval: 1s
    heartbeat-interval: 30s
    heartbeat-stagger-seconds: [0, 7, 14, 21]

  search:
    baidu-api-key: ""

# 必填模型密钥：export DASHSCOPE_API_KEY=sk-xxx
# 兼容旧变量：export QWEN_API_KEY=sk-xxx
# 飞书模式：export QINGLING_FEISHU_ENABLED=true FEISHU_APP_ID=... FEISHU_APP_SECRET=...
# 可选搜索：export BAIDU_APPBUILDER_API_KEY=...
