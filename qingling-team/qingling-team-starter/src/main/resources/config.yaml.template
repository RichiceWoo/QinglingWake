# 复制为项目根目录 config.yaml 后按需调整；所有密钥继续通过环境变量提供。
qingling:
  workspace:
    id: qingling-team
    name: Qingling Team
    root: ./workspace
  data-dir: ./data

  feishu:
    enabled: false
    allowed-chats: []

  agent:
    # 父 Agent 与子 Agent 首版共用 Provider；可选 dashscope 或 newapi。
    provider: dashscope
    # NewAPI 首个真实模型固定为 qwen3.8；默认 DashScope 保持 qwen3-max。
    model: qwen3-max
    sub-agent-model: qwen3-max
    free-model-selection-enabled: false
    validate-explicit-model: false
    model-candidates:
      - qwen3.8-27b
      - qwen3.8-2.4t-a95b
      - deepseek-v4.1-flash
      - glm-5.3
      - kimi-k3
      - deepseek-v4-flash-0731
      - qwen3.7-flash-2026-07-15
      - qwen3.7-flash
    model-probe-timeout: 20s
    max-iterations: 30
    max-input-tokens: 30000
    max-output-tokens: 8192
    sub-agent-max-iterations: 20
    # 长工具必须在 AgentScope 核心 PT5M 超时前转入后台任务。
    async-tool-offload-timeout: 30s
    # 关闭阶段独立短排空，不复用可能达到 30 分钟的业务 Agent 超时。
    shutdown-drain-timeout: 30s
    timeout: 300s
    dashscope:
      model-probe-url: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
    new-api:
      # 当前实际请求域名尚未开放；选择 newapi 前必须通过 NEWAPI_BASE_URL 提供 HTTPS `/v1` 根地址。
      base-url: ""

  sandbox:
    enabled: true
    url: http://localhost:8029/mcp
    workspace-dir: /workspace
    timeout: 120s
    initialization-timeout: 30s
    max-retries: 2
    enabled-tools: [sandbox_execute_bash]
    headers: {}

  memory:
    context-dir: ./data/ctx
    db-dsn: ""
    dashscope:
      # Memory 永远使用独立 DashScope 配置，不继承 Agent Provider。
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1/
      extract-model: qwen3.6-max-preview
      embedding-model: text-embedding-v3

  team:
    roles: [manager, pm, rd, qa]

  debug:
    test-api-enabled: false
    reply-timeout: 300s

  metrics:
    enabled: true

  cleanup:
    enabled: true
    run-on-startup: true
    session-retention-days: 365
    rules:
      workspace/sessions/*/tmp: 1
      workspace/sessions/*/uploads: 7
      workspace/sessions/*/outputs: 30
      traces: 30

  cron:
    tick-interval: 1s
    heartbeat-interval: 30s
    heartbeat-stagger-seconds: [0, 7, 14, 21]

  search:
    baidu-api-key: ""

  workflow:
    # runtime v2 完成全部验证前使用 legacy；新项目切换时显式改为 coordinated。
    coordination-mode: legacy
    # STANDARD 保留四角色产物契约，但不让 optional review 或子 Agent 阻断主路径。
    default-profile: standard
    review-policy: required-only
    advisory-audit-enabled: true
    review-timeout: 10m

# 默认 DashScope：export QINGLING_MODEL_PROVIDER=dashscope DASHSCOPE_API_KEY=sk-xxx
# NewAPI（地址开放后）：export QINGLING_MODEL_PROVIDER=newapi NEWAPI_API_KEY=sk-xxx NEWAPI_BASE_URL=https://newapi.example.com/v1 QINGLING_AGENT_MODEL=qwen3.8 QINGLING_SUB_AGENT_MODEL=qwen3.8
# pgvector 开启后独立配置：export QINGLING_MEMORY_DB_DSN=jdbc:postgresql://db:5432/qingling QINGLING_MEMORY_DASHSCOPE_API_KEY=sk-xxx
# 工具链稳定期：export QINGLING_FREE_MODEL_SELECTION_ENABLED=false QINGLING_AGENT_MODEL=qwen3-max QINGLING_SUB_AGENT_MODEL=qwen3-max
# 免费候选模式：export QINGLING_FREE_MODEL_SELECTION_ENABLED=true
# 旧 QINGLING_DYNAMIC_MODEL_SELECTION_ENABLED 仅在新开关未设置时作为兼容回退。
# 兼容旧变量：export QWEN_API_KEY=sk-xxx
# 飞书模式：export QINGLING_FEISHU_ENABLED=true FEISHU_APP_ID=... FEISHU_APP_SECRET=...
# 可选搜索：export BAIDU_APPBUILDER_API_KEY=...
